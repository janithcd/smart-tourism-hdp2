rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only a Firebase Console or Admin SDK operator can create/change an admin document.
    // The existing project uses admins/{authUid}: { active: true, role: 'admin' }.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    function validTour() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'title', 'duration', 'price', 'categoryId', 'description',
          'route', 'overview', 'imageUrl', 'active', 'featured'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.duration is string && data.duration.size() > 0 && data.duration.size() <= 40
        && data.price is number && data.price > 0 && data.price <= 1000000
        && data.categoryId is string && data.categoryId.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.route is string && data.route.size() <= 2000
        && data.overview is string && data.overview.size() <= 2000
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && (data.imageUrl == '' || data.imageUrl.matches('https://.*'))
        && data.active is bool && data.featured is bool;
    }

    function validCategory() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'active'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.active is bool
        && (!data.keys().hasAny(['description']) ||
          (data.description is string && data.description.size() <= 2000))
        && (!data.keys().hasAny(['imageUrl']) ||
          (data.imageUrl is string && data.imageUrl.size() <= 500
            && (data.imageUrl == '' || data.imageUrl.matches('https://.*'))));
    }

    function validService() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'type', 'title', 'duration', 'price', 'capacity',
          'pickup', 'description', 'imageUrl', 'active'
        ])
        && data.type in ['Vehicle', 'Guide']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.duration is string && data.duration.size() > 0 && data.duration.size() <= 40
        && data.price is number && data.price > 0 && data.price <= 1000000
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 30
        && data.pickup is string && data.pickup.size() > 0 && data.pickup.size() <= 200
        && data.description is string && data.description.size() > 0
        && data.description.size() <= 2000
        && data.imageUrl is string && data.imageUrl.size() <= 500
        && (data.imageUrl == '' || data.imageUrl.matches('https://.*'))
        && data.active is bool;
    }

    // Demo submissions are user supplied; payment details never prove a real charge.
    function validDemoBooking(bookingId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'uid', 'email', 'source', 'title', 'type', 'duration', 'price',
          'route', 'pax', 'pickup', 'mobile', 'date', 'time', 'paymentMethod',
          'paymentStatus', 'reviewStatus', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'email', 'source', 'title', 'type', 'duration', 'price',
          'route', 'pax', 'pickup', 'mobile', 'date', 'time', 'paymentMethod',
          'paymentStatus', 'reviewStatus', 'createdAt'
        ])
        && data.id == bookingId && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.source == 'demo' && data.reviewStatus == 'New'
        && data.createdAt == request.time
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.type is string && data.type.size() > 0 && data.type.size() <= 40
        && data.duration is string && data.duration.size() <= 80
        && data.price is string && data.price.size() <= 80
        && data.route is string && data.route.size() <= 2000
        && data.pax is string && data.pax.size() <= 40
        && data.pickup is string && data.pickup.size() <= 250
        && data.mobile is string && data.mobile.size() <= 40
        && data.date is string && data.date.size() > 0 && data.date.size() <= 40
        && data.time is string && data.time.size() > 0 && data.time.size() <= 40
        && data.paymentMethod in ['Cash on arrival', 'Card (simulation)', 'Mobile wallet (simulation)']
        && data.paymentStatus == (data.paymentMethod == 'Cash on arrival'
          ? 'Payment due on arrival' : 'Paid (simulation only)');
    }

    match /admins/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'fname', 'lname', 'email', 'country', 'birthday', 'profilePic'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fname', 'lname', 'country', 'birthday', 'profilePic'
        ]);
      allow delete: if owns(uid);

      match /wishlist/{itemId} {
        allow read, write: if owns(uid);
      }
    }

    match /packages/{packageId} {
      // Tourist queries must include whereEqualTo('active', true).
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validTour()
        && request.resource.data.keys().hasOnly([
          'title', 'duration', 'price', 'categoryId', 'description',
          'route', 'overview', 'imageUrl', 'active', 'featured'
        ]);
      allow update: if isAdmin() && validTour()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'duration', 'price', 'categoryId', 'description',
          'route', 'overview', 'imageUrl', 'active', 'featured'
        ]);
      allow delete: if false; // Hide a tour with active: false instead.
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validCategory()
        && request.resource.data.keys().hasOnly(['title', 'active', 'description', 'imageUrl']);
      allow update: if isAdmin() && validCategory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'active', 'description', 'imageUrl'
        ]);
      allow delete: if false;
    }

    match /services/{serviceId} {
      // Tourist queries must include whereEqualTo('active', true).
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && validService()
        && request.resource.data.keys().hasOnly([
          'type', 'title', 'duration', 'price', 'capacity',
          'pickup', 'description', 'imageUrl', 'active'
        ]);
      allow update: if isAdmin() && validService()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'type', 'title', 'duration', 'price', 'capacity',
          'pickup', 'description', 'imageUrl', 'active'
        ]);
      allow delete: if false; // Hide a listing with active: false instead.
    }

    match /demo_bookings/{bookingId} {
      allow get: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if signedIn() && validDemoBooking(bookingId);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus'])
        && request.resource.data.reviewStatus in ['New', 'Reviewed'];
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
